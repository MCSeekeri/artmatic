---
/** 03 生成器：一块满栏的动态 Mandelbrot，读数是真读数（来自着色器同一组常量）。 */
import AlgoCanvas from './AlgoCanvas.svelte';
---

<section class="sec" id="generators">
  <div class="board">
    <div class="row">
      <div class="c-3 aside">
        <p class="kicker"><b>03</b> 生成器</p>
      </div>

      <div class="c-9 vr">
        <h2 class="h2">不用写代码也能创作数学之美。</h2>
        <p class="sub">由算法驱动的数学艺术，秩序之美纤毫毕现。</p>

        <p class="body">
          中心点、放大倍率、迭代数、幂次。分形、物理模拟、元胞自动机。一切都被参数化。Artmatic 让你轻而易举地创造这些炫技似的算法艺术。
        </p>
      </div>
    </div>

    <div class="row">
      <div class="c-12 flush">
        <div class="stage"><AlgoCanvas scene="mandelbrot" hud budget={1500000} client:visible /></div>
      </div>
    </div>

    <div class="row">
      <div class="c-12">
        <p class="note">
          变体 · 中心点 · 放大倍率（log）· 迭代数 · 幂次 · 调色板 · 快速逸色 · 慢速逸色 · 内部色 · 内部分辨率
        </p>
      </div>
    </div>
  </div>
</section>

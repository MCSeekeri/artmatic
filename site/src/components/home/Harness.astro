---
/**
 * 04 Harness：先一个字标带，再说法，最后一张真工具调用的卡。
 *
 * 代码卡里的工具名与参数名来自 `src/agent/tools.ts`，由 scripts/gen-stats.mjs
 * 在构建时校验还在 —— 改了工具表而没改这里，build 会红。
 */
import Brand from '../Brand.astro';
import stats from '../../data/stats.json';

/* 代码卡逐行拼，不直接写进模板：`{"defId": …}` 里的花括号会被 Astro 当成表达式。 */
const lines = [
  { said: '> 把这一段换成 lenia，16 秒起叠一层像素排序', tool: '', args: '' },
  { said: '', tool: 'set_generator', args: '    clipId="c7a1"  generator="lenia"' },
  { said: '', tool: 'add_effect_clip', args: '  trackId="V2"   start=16  end=24' },
  { said: '', tool: '', args: '                 chain=[{"defId":"pixel-sort"}]' },
];
---

<section class="sec" id="harness">
  <div class="board">
    <div class="row">
      <div class="c-12">
        <div class="lockup">
          <i>&lt;</i>
          <Brand variant="fonttype" height="clamp(1.5rem, 3.2vw, 2.3rem)" />
          <em>Harness</em>
          <i>&gt;</i>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="c-3 aside">
        <p class="kicker"><b>04</b> Harness</p>
      </div>

      <div class="c-9 vr">
        <h2 class="h2">你所见的一切，它亦能触及。</h2>
        <p class="sub">
          我们至今没搞明白，为什么 P<span class="px">R</span>、A<span class="px">E</span
          > 和达<span class="px">芬</span>奇不在侧栏塞一个对话框。总之我们塞了。
        </p>

        <p class="body">
          读场景、改参数、加片段、写排版、甚至现场写插件。向 Agent 描述你想要的任何画面，将你选中的视频片段和排版元素加入它的上下文。Artmatic 从底层就支持 AI Agent 协作，乃至自主创作。
        </p>
      </div>
    </div>

    <div class="row">
      <div class="c-5 aside">
        <p class="kicker"><b>{stats.tools}</b> 个工具</p>
        <p class="body" style="margin-top:0">
          工具表同时供应用内面板和 MCP 网关使用：同一个动作只有一处实现。自带 key 就能用；不想用 AI 也不影响任何功能。
        </p>
      </div>

      <div class="c-7 vr">
        <figure class="code-card">
          <div class="bar"><i></i><span>harness</span></div>
          <div class="code">
            {
              lines.map((line) => (
                <span class={line.said ? 'said' : 'call'}>
                  {line.said}
                  {line.tool && <em>{line.tool}</em>}
                  {line.args}
                </span>
              ))
            }
          </div>
        </figure>
      </div>
    </div>
  </div>
</section>

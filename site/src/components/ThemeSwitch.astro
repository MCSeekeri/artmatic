---
/**
 * 顶栏的主题切换。替掉 Starlight 的原生 <select>（浏览器给它的样式改不动，
 * 且菜单区在暗色下是浅色的），换成一个按钮 + 自绘列表。
 *
 * 状态仍存在 Starlight 的 key（`starlight-theme`）里，并回调它的 `updatePickers` ——
 * 文档页的移动菜单里还有一份官方的选择器，两边必须是同一个状态，否则
 * 「首页切成暗色、进文档又变回亮色」。
 */
---

<div class="tsw" data-theme-switch data-mode="auto">
  <button class="tsw-btn" type="button" aria-haspopup="listbox" aria-expanded="false">
    <span class="tsw-ico">
      <svg class="i-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2.5" y="4" width="19" height="12.5" rx="1.6"></rect>
        <path d="M8.5 20h7M12 16.5V20"></path>
      </svg>
      <svg class="i-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2"></circle>
        <path d="M12 2.6v2.2M12 19.2v2.2M4.4 12H2.2M21.8 12h-2.2M6.6 6.6 5.1 5.1M18.9 18.9l-1.5-1.5M17.4 6.6l1.5-1.5M5.1 18.9l1.5-1.5"></path>
      </svg>
      <svg class="i-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
      </svg>
    </span>
    <span class="tsw-label">自动</span>
    <svg class="tsw-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <path d="m6 9.5 6 6 6-6"></path>
    </svg>
  </button>

  <div class="tsw-menu" role="listbox" aria-label="主题" hidden>
    <button type="button" role="option" data-theme-value="auto" aria-selected="true">自动</button>
    <button type="button" role="option" data-theme-value="light" aria-selected="false">亮色</button>
    <button type="button" role="option" data-theme-value="dark" aria-selected="false">暗色</button>
  </div>
</div>

<style>
  .tsw {
    position: relative;
    display: flex;
  }
  .tsw-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    height: 30px;
    padding: 0 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--text-secondary);
    font-family: var(--sl-font);
    font-size: 12.5px;
    cursor: pointer;
    transition:
      border-color 120ms ease,
      color 120ms ease;
  }
  .tsw-btn:hover {
    border-color: var(--border-strong);
    color: var(--text-primary);
  }
  .tsw[data-open] .tsw-btn {
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  .tsw-ico {
    display: grid;
    width: 15px;
    height: 15px;
    place-items: center;
  }
  .tsw-ico svg {
    display: none;
    width: 15px;
    height: 15px;
  }
  .tsw[data-mode='auto'] .i-auto,
  .tsw[data-mode='light'] .i-light,
  .tsw[data-mode='dark'] .i-dark {
    display: block;
  }

  .tsw-caret {
    width: 12px;
    height: 12px;
    opacity: 0.65;
    transition: transform 140ms ease;
  }
  .tsw[data-open] .tsw-caret {
    transform: rotate(180deg);
  }

  .tsw-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    z-index: var(--z-menu, 100);
    display: grid;
    min-width: 104px;
    padding: 4px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface-3);
    box-shadow: var(--shadow-float);
  }
  .tsw-menu[hidden] {
    display: none;
  }
  .tsw-menu button {
    display: flex;
    align-items: center;
    height: 28px;
    padding: 0 0.55rem;
    border: 0;
    border-radius: 3px;
    background: transparent;
    color: var(--text-secondary);
    font-family: var(--sl-font);
    font-size: 13px;
    text-align: start;
    cursor: pointer;
  }
  .tsw-menu button:hover {
    background: var(--surface-hover);
    color: var(--text-primary);
  }
  .tsw-menu button[aria-selected='true'] {
    color: var(--text-primary);
    font-weight: 700;
  }
  .tsw-menu button[aria-selected='true']::before {
    content: '';
    width: 4px;
    height: 4px;
    margin-inline-end: 0.45rem;
    background: var(--accent);
  }
  .tsw-menu button:not([aria-selected='true'])::before {
    content: '';
    width: 4px;
    height: 4px;
    margin-inline-end: 0.45rem;
  }

  @media (max-width: 50em) {
    .tsw-label {
      display: none;
    }
    .tsw-caret {
      display: none;
    }
  }
</style>

<script>
  type Mode = 'auto' | 'light' | 'dark';

  const KEY = 'starlight-theme';
  const LABEL: Record<Mode, string> = { auto: '自动', light: '亮色', dark: '暗色' };
  const parse = (value: string | null): Mode =>
    value === 'light' || value === 'dark' ? value : 'auto';
  const prefersLight = () => matchMedia('(prefers-color-scheme: light)').matches;

  const roots = [...document.querySelectorAll<HTMLElement>('[data-theme-switch]')];

  function sync() {
    const mode = parse(localStorage.getItem(KEY));
    for (const root of roots) {
      root.dataset.mode = mode;
      const label = root.querySelector('.tsw-label');
      if (label) label.textContent = LABEL[mode];
      for (const item of root.querySelectorAll<HTMLElement>('[data-theme-value]')) {
        item.setAttribute('aria-selected', String(item.dataset.themeValue === mode));
      }
    }
  }

  function apply(mode: Mode) {
    document.documentElement.dataset.theme =
      mode === 'auto' ? (prefersLight() ? 'light' : 'dark') : mode;
    /* Starlight 用空串表示「自动」，别存 'auto' —— 它的 ThemeProvider 会读这个值 */
    localStorage.setItem(KEY, mode === 'auto' ? '' : mode);
    (window as unknown as { StarlightThemeProvider?: { updatePickers?: (m: Mode) => void } })
      .StarlightThemeProvider?.updatePickers?.(mode);
    sync();
  }

  function close(root: HTMLElement) {
    delete root.dataset.open;
    root.querySelector('.tsw-btn')?.setAttribute('aria-expanded', 'false');
    root.querySelector<HTMLElement>('.tsw-menu')?.setAttribute('hidden', '');
  }

  for (const root of roots) {
    const button = root.querySelector<HTMLButtonElement>('.tsw-btn');
    const menu = root.querySelector<HTMLElement>('.tsw-menu');
    if (!button || !menu) continue;

    button.addEventListener('click', () => {
      const open = !root.dataset.open;
      if (open) {
        root.dataset.open = '';
        button.setAttribute('aria-expanded', 'true');
        menu.removeAttribute('hidden');
      } else {
        close(root);
      }
    });

    menu.addEventListener('click', (event) => {
      const item = (event.target as HTMLElement).closest<HTMLElement>('[data-theme-value]');
      if (!item?.dataset.themeValue) return;
      apply(item.dataset.themeValue as Mode);
      close(root);
      button.focus();
    });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target as Node)) close(root);
    });
    root.addEventListener('keydown', (event) => {
      if ((event as KeyboardEvent).key === 'Escape') {
        close(root);
        button.focus();
      }
    });
  }

  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (parse(localStorage.getItem(KEY)) === 'auto') apply('auto');
  });

  sync();
</script>

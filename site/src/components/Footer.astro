---
import Pagination from '@astrojs/starlight/components/Pagination.astro';
import { GITHUB, url } from '../data/site';
import stats from '../data/stats.json';
---

<footer class="site-footer">
  <Pagination />
  <div class="footer-meta mono">
    <span>v{stats.appVersion} · Apache-2.0</span>
    <span>
      <a href={GITHUB}>源码</a>
      <a href={`${GITHUB}/blob/main/LICENSE`}>许可</a>
      <a href={`${GITHUB}/blob/main/CREDITS.md`}>致谢</a>
    </span>
  </div>
  <p class="footer-note">
    本项目和 U&amp;I Software 的 ArtMatic 无任何关联。字体为 OFL-1.1，见
    <a href={url('/licenses/OFL.txt')}>OFL.txt</a>。
  </p>
</footer>

<style>
  @layer starlight.core {
    .site-footer {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      margin-top: 3rem;
      border-top: 1px solid var(--border);
      padding-top: 1rem;
    }
    .footer-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      justify-content: space-between;
    }
    .footer-meta a {
      margin-inline-start: 1rem;
      color: var(--text-secondary);
      text-decoration: none;
    }
    .footer-meta a:hover {
      color: var(--text-primary);
    }
    .footer-note {
      margin: 0;
      font-size: 12px;
      color: var(--text-muted);
    }
  }
</style>

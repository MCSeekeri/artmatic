{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": [
      "vite/client",
      "node",
      "svelte"
    ]
  },
  "include": [
    "../src/core/**/*.ts",
    "../src/agent/**/*.ts",
    "../src/types/**/*.d.ts"
  ]
}

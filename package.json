{
  "name": "artmatic",
  "private": true,
  "version": "0.3.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:mutate": "stryker run",
    "test:e2e": "node scripts/e2e.mjs",
    "mcp": "node mcp/index.mjs",
    "cli": "node scripts/cli.mjs",
    "capacity": "node scripts/capacity.mjs",
    "fonts:sfnt": "node scripts/fonts-woff2-to-sfnt.mjs",
    "desktop": "electron desktop/main.mjs",
    "desktop:probe": "electron desktop/main.mjs --probe",
    "desktop:artifact": "bun run build && node desktop/build.mjs",
    "desktop:smoke": "node desktop/smoke.mjs"
  },
  "trustedDependencies": [
    "electron"
  ],
  "dependencies": {
    "@lucide/svelte": "^1.49.0",
    "@zumer/snapdom": "^3.2.0",
    "fflate": "^0.8.2",
    "gifenc": "^1.0.3",
    "gl-transitions": "^1.71.0",
    "harfbuzzjs": "^1.6.2",
    "marked": "^18.1.1",
    "mediabunny": "^1.61.0",
    "polygon-clipping": "^0.15.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.55.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@types/node": "^26.6.3",
    "electron": "^44.9.0",
    "svelte": "^5.38.0",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "wawoff2": "^2.0.1"
  }
}
